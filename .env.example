# ==============================================================================
# TrustVault - Environment Configuration Template
# DO NOT COMMIT SENSITIVE VALUES OR ACTUAL SECRETS TO VERSION CONTROL.
# Copy this file to .env and adjust for your local or production environment.
# ==============================================================================

# Application Environment: exactly 'development', 'production', or 'testing'.
# Capitalized, abbreviated, or misspelled values are rejected at startup.
ENVIRONMENT=development
APP_NAME=TrustVault
API_V1_PREFIX=/api/v1
DEBUG=false

# Security & Sessions (Must be at least 32 cryptographically random bytes in production)
# Example generation: openssl rand -hex 32
SECRET_KEY=change_me_to_a_secure_random_secret_at_least_32_bytes_long!
SESSION_COOKIE_NAME=trustvault_session
# Production startup fails unless this is true. Requires HTTPS termination.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax
SESSION_MAX_AGE_SECONDS=86400 # 24 hours
CSRF_COOKIE_NAME=trustvault_csrf

# Database Configuration
# Development / testing may use SQLite. Production requires a PostgreSQL URL
# with a non-empty username and password. Production startup rejects SQLite,
# missing credentials, and known default passwords (for example,
# 'trustvault_password'). Percent-encode URL-reserved characters in the password.
# DATABASE_URL=postgresql+psycopg://trustvault_app:<url-encoded-strong-password>@db:5432/trustvault
DATABASE_URL=sqlite:///./trustvault.db

# Docker Compose production deployment
# Compose refuses to start unless POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB,
# DATABASE_URL, and SECRET_KEY are set explicitly. Set POSTGRES_PASSWORD to a
# strong unique value and percent-encode it separately in DATABASE_URL.
# POSTGRES_USER=trustvault_app
# POSTGRES_PASSWORD=<strong-unique-password>
# POSTGRES_DB=trustvault
# DATABASE_URL=postgresql+psycopg://trustvault_app:<url-encoded-strong-password>@db:5432/trustvault
# SECRET_KEY=<at-least-32-random-bytes>

# Private Persistent Storage (Must remain OUTSIDE the web root)
STORAGE_DIR=./private_storage
MAX_FILE_SIZE_BYTES=10485760 # 10MB per-file limit
# Multipart request allowance above the file limit for headers, boundaries,
# and ordinary form fields. Non-multipart request bodies use the JSON limit.
MAX_MULTIPART_OVERHEAD_BYTES=1048576
MAX_JSON_BODY_BYTES=65536
# Age before startup reconciliation removes an unreferenced file or stale
# staging file. Protects uploads in progress in other workers.
STORAGE_ORPHAN_GRACE_SECONDS=3600

# Per-user and platform-wide storage quotas. Rejections are audited.
MAX_USER_STORAGE_BYTES=104857600 # 100 MiB active bytes per user
MAX_GLOBAL_STORAGE_BYTES=1073741824 # 1 GiB active bytes across the platform
MAX_UPLOADS_PER_USER=1000

# Allowed File Extensions (MIME types are also inspected via magic bytes)
ALLOWED_EXTENSIONS=.pdf,.txt,.md,.png,.jpg,.jpeg,.docx,.xlsx

# Audit Retention Policy
# The online hash chain is retained indefinitely because verification requires
# it. AUDIT_RETENTION_DAYS applies only to independently held archive copies.
# Setting AUDIT_RETENTION_AUTO_DELETE=true is unsupported and fails startup.
AUDIT_RETENTION_DAYS=2555
AUDIT_RETENTION_AUTO_DELETE=false

# Rate Limiting
# Login attempts are counted in a shared, expiring database table so limits
# apply across workers and application instances. If the table cannot be
# reached, login fails closed with 503 instead of using in-memory state.
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# Upper bound on retained limiter buckets. Expired rows are reset on use and
# reclaimed when capacity is needed; when the table is full, new login attempts
# fail closed instead of using unbounded state.
LOGIN_RATE_LIMIT_MAX_BUCKETS=50000

# Trusted reverse-proxy client IPs
# Comma-separated CIDRs whose X-Forwarded-For header may be trusted. The
# immediate peer must match one of these networks. Leave empty when clients
# connect directly to the backend. Never configure 0.0.0.0/0 or ::/0.
# Docker Compose: leave empty unless you add a trusted reverse proxy.
# Render: set the exact proxy CIDR(s) for your service in the dashboard.
TRUSTED_PROXY_IPS=

# Administrative Audit Verification Resource Controls
# A chain larger than AUDIT_VERIFY_MAX_RECORDS returns an explicit INCOMPLETE result.
AUDIT_VERIFY_MAX_RECORDS=100000
AUDIT_VERIFY_BATCH_SIZE=1000
AUDIT_VERIFY_TIMEOUT_SECONDS=30
# Applied per administrator, per process. Not shared across workers or instances.
AUDIT_VERIFY_RATE_LIMIT_MAX_REQUESTS=5
AUDIT_VERIFY_RATE_LIMIT_WINDOW_SECONDS=60

# Audit Checkpoint Anchoring
# Modes: 'disabled' (default outside production), 'local_file' (development only),
# or 's3' (external). 'local_file' shares this application host and filesystem and
# is NOT independent anchoring; production startup rejects it. Production requires
# 's3' with an independently controlled bucket. No bucket or credentials ship with
# this repository and no provider is configured by default, so production startup
# fails closed until an external anchor is configured and verified.
AUDIT_ANCHOR_MODE=disabled
AUDIT_ANCHOR_DIR=./audit_checkpoints
# Required when AUDIT_ANCHOR_MODE is 'local_file' or 's3'. At least 32 characters.
# Generate with: openssl rand -hex 32
AUDIT_ANCHOR_HMAC_KEY=
# Applied per administrator, per process for checkpoint create/verify requests.
AUDIT_CHECKPOINT_RATE_LIMIT_MAX_REQUESTS=5
AUDIT_CHECKPOINT_RATE_LIMIT_WINDOW_SECONDS=60
# Scheduled checkpoint creation and freshness alerting. The maximum age must be
# greater than or equal to the interval.
AUDIT_CHECKPOINT_INTERVAL_SECONDS=3600
AUDIT_CHECKPOINT_MAX_AGE_SECONDS=7200

# External S3 anchoring (AUDIT_ANCHOR_MODE=s3)
# Credentials are NOT configured here. boto3 uses the AWS default credential chain
# (environment, shared config, or instance/task role). Grant least-privilege access
# to the configured prefix only; see docs/ARCHITECTURE.md for the policy and
# operational guidance. Values below are placeholders, not a live configuration.
# The service must honor S3 conditional PutObject (If-None-Match) and provide
# read-after-write consistency; verify this before relying on it as an anchor.
AUDIT_ANCHOR_S3_BUCKET=
AUDIT_ANCHOR_S3_REGION=
AUDIT_ANCHOR_S3_PREFIX=trustvault-audit-checkpoints
# Optional custom endpoint for S3-compatible services. Must be https in production.
AUDIT_ANCHOR_S3_ENDPOINT_URL=
# Optional server-side encryption with a customer-managed KMS key.
AUDIT_ANCHOR_S3_KMS_KEY_ID=
# Optional Object Lock mode ('GOVERNANCE' or 'COMPLIANCE'). The bucket must have
# Object Lock enabled; strongly recommended for tamper resistance.
AUDIT_ANCHOR_S3_OBJECT_LOCK_MODE=
AUDIT_ANCHOR_S3_OBJECT_LOCK_DAYS=30
# Request timeouts and retry budget for external checkpoint store calls.
AUDIT_ANCHOR_S3_CONNECT_TIMEOUT_SECONDS=5
AUDIT_ANCHOR_S3_READ_TIMEOUT_SECONDS=10
AUDIT_ANCHOR_S3_MAX_ATTEMPTS=3

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Seed Account Settings
# These settings are reserved by the application configuration, but no seed
# script ships in this repository and they are not applied automatically.
# Never use these demo values in production.
SEED_ADMIN_EMAIL=admin@trustvault.local
SEED_ADMIN_PASSWORD=AdminSecurePass123!
SEED_OWNER_EMAIL=owner@trustvault.local
SEED_OWNER_PASSWORD=OwnerSecurePass123!
SEED_VIEWER_EMAIL=viewer@trustvault.local
SEED_VIEWER_PASSWORD=ViewerSecurePass123!
