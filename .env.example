# ==============================================================================
# TrustVault - Environment Configuration Template
# DO NOT COMMIT SENSITIVE VALUES OR ACTUAL SECRETS TO VERSION CONTROL.
# Copy this file to .env and adjust for your local or production environment.
# ==============================================================================

# Application Environment: 'development', 'production', or 'testing'
ENVIRONMENT=development
APP_NAME=TrustVault
API_V1_PREFIX=/api/v1
DEBUG=false

# Security & Sessions (Must be at least 32 cryptographically random bytes in production)
# Example generation: openssl rand -hex 32
SECRET_KEY=change_me_to_a_secure_random_secret_at_least_32_bytes_long!
SESSION_COOKIE_NAME=trustvault_session
SESSION_COOKIE_SECURE=false # Set to true in production (requires HTTPS)
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax
SESSION_MAX_AGE_SECONDS=86400 # 24 hours
CSRF_COOKIE_NAME=trustvault_csrf

# Database Configuration
# Production / Local PostgreSQL (psycopg3 driver):
# DATABASE_URL=postgresql+psycopg://trustvault_user:trustvault_password@localhost:5432/trustvault_db
# Local SQLite fallback for instant zero-dependency testing / development:
DATABASE_URL=sqlite:///./trustvault.db

# Private Persistent Storage (Must remain OUTSIDE the web root)
STORAGE_DIR=./private_storage
MAX_FILE_SIZE_BYTES=10485760 # 10MB limit

# Allowed File Extensions (MIME types are also inspected via magic bytes)
ALLOWED_EXTENSIONS=.pdf,.txt,.md,.png,.jpg,.jpeg,.docx,.xlsx

# Rate Limiting
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Administrative Audit Verification Resource Controls
# A chain larger than AUDIT_VERIFY_MAX_RECORDS returns an explicit INCOMPLETE result.
AUDIT_VERIFY_MAX_RECORDS=100000
AUDIT_VERIFY_BATCH_SIZE=1000
AUDIT_VERIFY_TIMEOUT_SECONDS=30
# Applied per administrator, per process. Not shared across workers or instances.
AUDIT_VERIFY_RATE_LIMIT_MAX_REQUESTS=5
AUDIT_VERIFY_RATE_LIMIT_WINDOW_SECONDS=60

# Audit Checkpoint Anchoring
# Modes: 'disabled' (default) or 'local_file'.
# 'local_file' is a DEVELOPMENT-ONLY adapter that shares this application host and
# filesystem. It is NOT independent production anchoring. No external provider
# adapter is implemented in this build, so production anchoring remains unconfigured.
AUDIT_ANCHOR_MODE=disabled
AUDIT_ANCHOR_DIR=./audit_checkpoints
# Required when AUDIT_ANCHOR_MODE=local_file. At least 32 characters.
# Generate with: openssl rand -hex 32
AUDIT_ANCHOR_HMAC_KEY=
# Applied per administrator, per process for checkpoint create/verify requests.
AUDIT_CHECKPOINT_RATE_LIMIT_MAX_REQUESTS=5
AUDIT_CHECKPOINT_RATE_LIMIT_WINDOW_SECONDS=60

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Seed Account Credentials (Used ONLY by scripts/seed.py for demo/initial deployment)
SEED_ADMIN_EMAIL=admin@trustvault.local
SEED_ADMIN_PASSWORD=AdminSecurePass123!
SEED_OWNER_EMAIL=owner@trustvault.local
SEED_OWNER_PASSWORD=OwnerSecurePass123!
SEED_VIEWER_EMAIL=viewer@trustvault.local
SEED_VIEWER_PASSWORD=ViewerSecurePass123!
